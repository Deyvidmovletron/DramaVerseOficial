# Geral
ENVIRONMENT=development
SECRET_KEY=troque-esta-chave-por-uma-chave-secreta-forte
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
RESET_PASSWORD_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# Banco de dados
DATABASE_URL=sqlite:///./data/streaming.db

# CORS (origens do frontend, separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Diretório de mídia (capas, banners, vídeos baixados)
MEDIA_ROOT=./media

# URL base do frontend (usada para montar o link de redefinição de senha no e-mail)
FRONTEND_URL=http://localhost:5173

# E-mail (SMTP) — usado para "esqueci minha senha". Se SMTP_HOST ficar vazio, o sistema
# apenas loga o conteúdo do e-mail no console em vez de falhar (ambiente sem SMTP configurado).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_BACK_URL=http://localhost:5173/assinatura
# URL a configurar no painel do Mercado Pago para receber notificações (produção):
# https://seu-dominio.com/api/v1/webhooks/mercadopago

# Admin inicial (criado automaticamente no primeiro start se não existir nenhum admin)
FIRST_ADMIN_NAME=Administrador
FIRST_ADMIN_EMAIL=admin@stream-mais.com
FIRST_ADMIN_PASSWORD=troque-esta-senha
